POSTGRES_PASSWORD=replace-with-a-long-url-safe-alphanumeric-password
POSTGRES_DATA_PATH=postgres-data
GITHUB_TOKEN=replace-with-a-dedicated-read-only-token
# Optional additional credential authorized by GitHub for parallel crawling.
GITHUB_TOKEN_SECONDARY=
# Optional independent GitHub App installation lane. The private key is
# mounted read-only; never commit it or place the PEM contents in this file.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key.pem
GITHUB_USER_AGENT=github-cli
API_BIND=127.0.0.1
API_PORT=8080

# The defaults stay below GitHub's primary limits and leave retry headroom.
GRAPHQL_WORKERS=3
REST_ENUMERATION_WORKERS=1
GRAPHQL_KEY_BATCH_SIZE=225
GRAPHQL_POINTS_PER_HOUR=3600
REST_REQUESTS_PER_HOUR=4700
SEARCH_REQUESTS_PER_HOUR=1500
QUEUE_MAX_ACCOUNTS=50000
TAIL_POLL_INTERVAL=1m
OWNER_REFRESH_INTERVAL=168h
ESTIMATED_ACCOUNTS_LOW=190000000
ESTIMATED_ACCOUNTS_HIGH=220000000
